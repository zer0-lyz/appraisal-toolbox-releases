{
  "manifest_version": 3,
  "name": "评估工具箱",
  "description": "土地成交公示、司法拍卖、资产租赁、房产案例采集与折旧摊销测算工具箱，独立运行，不连接天源底稿系统。",
  "version": "0.1.0",
  "version_name": "0.1.0",
  "key": "",
  "action": {
    "default_title": "评估工具箱"
  },
  "background": {
    "service_worker": "src/background/service_worker.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "nativeMessaging",
    "sidePanel",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "https://*.taobao.com/*",
    "https://taobao.com/*",
    "https://*.alicdn.com/*",
    "https://*.alibaba-inc.com/*",
    "https://*.anjuke.com/*",
    "https://anjuke.com/*"
  ],
  "side_panel": {
    "default_path": "src/shell/index.html"
  }
}
